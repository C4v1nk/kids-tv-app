{
  // This is the file Cloudflare reads to know how to run this project.
  //
  // WHY THE SETTINGS KEPT CLEARING THEMSELVES
  // -----------------------------------------
  // For a Worker connected to GitHub, THIS FILE is the source of truth. Every
  // time Cloudflare deploys, it applies what is written here — so anything
  // typed into the dashboard by hand that this file doesn't mention gets wiped
  // on the next commit. That is why the variable disappeared every time the
  // index.html was updated. Nothing was going wrong; the dashboard was simply
  // losing an argument with this file.
  //
  // The fix is to stop typing it into the dashboard and declare it here, where
  // it is re-applied on every single deploy and can never be cleared again.
  //
  // "main" tells Cloudflare "run src/index.js for every request." Without it,
  // Cloudflare treats the repo as plain static files with no code behind them,
  // which is what caused the old "Variables cannot be added to a Worker that
  // only has static assets" error and why /watch-video never worked.
  //
  // "assets" tells that same code where the website files live and gives it a
  // name (ASSETS) to refer to them by — that is the env.ASSETS.fetch(request)
  // line in src/index.js, meaning "serve index.html the normal way."
  "name": "kids-tv-app",
  "compatibility_date": "2024-09-23",
  "main": "src/index.js",
  "assets": {
    "directory": ".",
    "binding": "ASSETS"
  },

  // The key the /watch-video relay uses. It is the SAME key already sitting in
  // index.html in this same public repo, so writing it here reveals nothing
  // that wasn't already visible — it just stops the deploy from clearing it.
  //
  // What it actually buys: without it, /watch-video falls back to reading
  // Google's "are you sure you want to download this?" web page and hunting
  // for the real link inside it, which breaks every time Google changes that
  // page. With it, the relay asks Google's official API instead. The TVs use
  // the key in index.html first and only reach this relay as a fallback, so
  // this is the safety net's safety net — worth having, never urgent.
  //
  // If you ever change this key, change it in BOTH places: here and in the
  // CONFIG block of index.html.
  "vars": {
    "GOOGLE_API_KEY": "AIzaSyDDAI4Tu9tVkldAife_SlLTnR-b6zW6ZSE"
  }
}
